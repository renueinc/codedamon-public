TTS_PROVIDER=voicevox
VOICEVOX_URL=https://<your-voicevox-host>
VOICEVOX_SPEAKER=3
VOICEVOX_API_KEY=your_api_key_here

# Cloud backend for auth, usage tracking, and cloud TTS.
# These values are handed to authenticated users via the registration / rotate-key
# response body. Do NOT publish real values in this sample file.
CLOUD_BACKEND_URL=https://<your-backend-host>
CLOUD_TTS_API_URL=https://<your-cloud-tts-host>/v1/tts

# Backend server: the URL that clients should use to reach this BE. Returned
# inside authenticated API responses so clients can populate their .env.
PUBLIC_BACKEND_URL=https://<your-backend-host>

# Backend: base URL for Stripe billing redirects
APP_BASE_URL=https://<your-app-domain>
